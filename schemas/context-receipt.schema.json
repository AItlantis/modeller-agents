{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitlantis.local/schemas/context-receipt.schema.json",
  "title": "ContextReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "algorithm_version",
    "created_at",
    "retrieval_query",
    "selection",
    "retained_refs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "algorithm_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "retrieval_query": { "type": "object" },
    "selection": { "type": "object" },
    "candidate_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact_ref" }
    },
    "retained_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact_ref" }
    },
    "excluded_refs": {
      "type": "array",
      "items": { "type": "object" }
    },
    "permissions_applied": { "type": "object" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer" }
      }
    }
  }
}
