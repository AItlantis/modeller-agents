{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitlantis.dev/modeller-pipelines/contracts/1.2/backend.schema.json",
  "title": "Modeller Pipeline Backend Manifest",
  "type": "object",
  "required": ["backend_id", "contract_version", "runner", "pipelines"],
  "properties": {
    "backend_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "contract_version": {
      "type": "string"
    },
    "runner": {
      "type": "object",
      "required": ["command", "interpreter", "platform"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "interpreter": {
          "type": "string"
        },
        "platform": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "definition"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "definition": {
            "type": "string"
          }
        }
      }
    },
    "smoke_pipeline": {
      "type": "string"
    },
    "docks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dock_id", "title", "dock_key", "entry_module", "doc"],
        "properties": {
          "dock_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string"
          },
          "dock_key": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9_.-]*[a-z0-9])?\\.v[0-9]+$"
          },
          "entry_module": {
            "type": "string"
          },
          "doc": {
            "type": "string"
          },
          "area": {
            "type": "string",
            "enum": ["left", "right", "top", "bottom"],
            "default": "right"
          },
          "debug_env": {
            "type": "string"
          },
          "reload_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "smoke_dock": {
      "type": "string"
    },
    "plugin": {
      "type": ["string", "null"]
    }
  }
}

