{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitlantis.dev/modeller-pipelines/contracts/1.2/result.schema.json",
  "title": "Modeller Pipeline Run Result",
  "type": "object",
  "required": [
    "contract_version",
    "backend_id",
    "pipeline_id",
    "pipeline_version",
    "run_id",
    "status",
    "timestamps",
    "config_path",
    "steps",
    "artifacts"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "backend_id": {
      "type": "string"
    },
    "pipeline_id": {
      "type": "string"
    },
    "pipeline_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"]
    },
    "timestamps": {
      "type": "object",
      "required": ["started_at", "completed_at"],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "config_path": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "step-result.schema.json"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "metrics": {
      "type": "object"
    },
    "logs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "error": {
      "type": ["object", "null"]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    }
  }
}
